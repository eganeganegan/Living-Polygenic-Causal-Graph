# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# ── Neo4j ─────────────────────────────────────────────────────────────────
# Local:   bolt://localhost:7687
# AuraDB:  neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required. Set to empty string if your instance has no password: NEO4J_PASSWORD=
NEO4J_PASSWORD=

# ── NCBI API key ──────────────────────────────────────────────────────────
# Optional but strongly recommended, raises PubTator rate limit from 3→10 req/s.
# Register free at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ── Pipeline ──────────────────────────────────────────────────────────────
# Comma-separated list of disease queries sent to PubTator 3
LPGC_DISEASES=Schizophrenia
# Rolling lookback window in hours for first-run / fallback fetches
LPGC_LOOKBACK_HOURS=24

# ── Dashboard ─────────────────────────────────────────────────────────────
# Bind to 127.0.0.1 (localhost only). Change to 0.0.0.0 only behind a
# reverse proxy with authentication, the dashboard has no built-in auth.
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=true

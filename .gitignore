# ── Secrets & environment ──────────────────────────────────────────────────
.env
*.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/

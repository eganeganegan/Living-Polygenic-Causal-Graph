# ── Data (potentially large, sensitive, or personally identifiable) ────────
data/raw/*
data/processed/*
data/gwas/*
# Keep the committed stubs
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/gwas/PLACEHOLDER
# Serialised Python objects and common data science output formats
*.pkl
*.pickle
*.parquet
*.h5
*.hdf5
# Log files
*.log
logs/

# ── Testing & coverage ────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/

